9;--shiki-dark:#C792EA\"> }</span><span style=\"color:#999999;--shiki-dark:#C792EA\"> =</span><span style=\"color:#59873A;--shiki-light-font-style:inherit;--shiki-dark:#82AAFF;--shiki-dark-font-style:italic\"> createNamespacedHelpers</span><span style=\"color:#999999;--shiki-dark:#D6DEEB\">(</span><span style=\"color:#B5695977;--shiki-dark:#D9F5DD\">'</span><span style=\"color:#B56959;--shiki-dark:#ECC48D\">moduleA</span><span style=\"color:#B5695977;--shiki-dark:#D9F5DD\">'</span><span style=\"color:#999999;--shiki-dark:#D6DEEB\">)</span></span>\n<span class=\"line\"><span style=\"color:#1E754F;--shiki-light-font-style:inherit;--shiki-dark:#C792EA;--shiki-dark-font-style:italic\">export</span><span style=\"color:#1E754F;--shiki-light-font-style:inherit;--shiki-dark:#C792EA;--shiki-dark-font-style:italic\"> default</span><span style=\"color:#999999;--shiki-dark:#D6DEEB\"> {</span></span>\n<span class=\"line\"><span style=\"color:#998418;--shiki-dark:#D6DEEB\">  computed</span><span style=\"color:#999999;--shiki-dark:#D6DEEB\">:</span><span style=\"color:#999999;--shiki-dark:#D6DEEB\"> {</span></span>\n<span class=\"line\"><span style=\"color:#999999;--shiki-dark:#7FDBCA\">    ...</span><span style=\"color:#59873A;--shiki-light-font-style:inherit;--shiki-dark:#82AAFF;--shiki-dark-font-style:italic\">mapState</span><span style=\"color:#999999;--shiki-dark:#D6DEEB\">([</span></span>\n<span class=\"line\"><span style=\"color:#B5695977;--shiki-dark:#D9F5DD\">      '</span><span style=\"color:#B56959;--shiki-dark:#ECC48D\">name</span><span style=\"color:#B5695977;--shiki-dark:#D9F5DD\">'</span></span>\n<span class=\"line\"><span style=\"color:#999999;--shiki-dark:#D6DEEB\">    ])</span></span>\n<span class=\"line\"><span style=\"color:#999999;--shiki-dark:#D6DEEB\">  },</span></span>\n<span class=\"line\"><span style=\"color:#998418;--shiki-dark:#D6DEEB\">  methods</span><span style=\"color:#999999;--shiki-dark:#D6DEEB\">:</span><span style=\"color:#999999;--shiki-dark:#D6DEEB\"> {</span></span>\n<span class=\"line\"><span style=\"color:#999999;--shiki-dark:#7FDBCA\">    ...</span><span style=\"color:#59873A;--shiki-light-font-style:inherit;--shiki-dark:#82AAFF;--shiki-dark-font-style:italic\">mapMutations</span><span style=\"color:#999999;--shiki-dark:#D6DEEB\">([</span></span>\n<span class=\"line\"><span style=\"color:#B5695977;--shiki-dark:#D9F5DD\">      '</span><span style=\"color:#B56959;--shiki-dark:#ECC48D\">setName</span><span style=\"color:#B5695977;--shiki-dark:#D9F5DD\">'</span></span>\n<span class=\"line\"><span style=\"color:#999999;--shiki-dark:#D6DEEB\">    ])</span></span>\n<span class=\"line\"><span style=\"color:#999999;--shiki-dark:#D6DEEB\">  }</span></span>\n<span class=\"line\"><span style=\"color:#999999;--shiki-dark:#D6DEEB\">}</span></span></code></pre>\n    <div class=\"svp-code-block--lang\">js</div>\n    <button class=\"svp-code-block--copy-btn\" aria-label=\"Copy code\"><span class=\"svp-code-block--copy-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path></svg></span><span class=\"svp-code-block--check-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg></span></button>\n    \n  </div>\n</div>\n<h3 id=\"use-mixin-组件中使用\">use-mixin-组件中使用</h3>\n<div class=\"svp-code-block-wrapper\"><div class=\"svp-code-block\">\n    \n    <pre class=\"shiki shiki-themes vitesse-light night-owl\" style=\"background-color:#ffffff;--shiki-dark-bg:#011627;color:#393a34;--shiki-dark:#d6deeb\" tabindex=\"0\"><code><span class=\"line\"><span>&#x3C;script></span></span>\n<span class=\"line\"><span>import moduleAMixin from 'path/to/moduleAMixin.js'</span></span>\n<span class=\"line\"><span>export default {</span></span>\n<span class=\"line\"><span>  mixins: [moduleAMixin]</span></span>\n<span class=\"line\"><span>}</span></span>\n<span class=\"line\"><span>&#x3C;/script></span></span></code></pre>\n    <div class=\"svp-code-block--lang\">vue</div>\n    <button class=\"svp-code-block--copy-btn\" aria-label=\"Copy code\"><span class=\"svp-code-block--copy-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path></svg></span><span class=\"svp-code-block--check-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg></span></button>\n    \n  </div>\n</div>\n<p>对于 moduleB 或者其他任何你想跨组件共享的 store 模块，都可以使用类似的方式</p>\n<blockquote>\n<p><strong>提示：关于 <code>mapGetters</code> 与 <code>mapActions</code> 的使用</strong></p>\n</blockquote>\n<ul>\n<li><code>mapGetters</code> 与 <code>mapState</code>的使用方式一致</li>\n<li><code>mapActions</code> 与 <code>mapMutations</code>的使用方式一致</li>\n</ul>\n<h3 id=\"总结\">总结</h3>\n<ul>\n<li>跨组件共享同一个模块的状态，使用 <code>mixin</code> 选项配合 Vuex 的 <code>createNamespacedHelpers</code>，<code>mapState</code>，<code>mapMutations</code>，<code>mapGetters</code>，<code>mapActions</code>\r\n可以将组件内部的 store 相关代码量降到很低的程度</li>\n<li>即使有了 Vuex，也并不意味着你需要将所有的数据都放到 Store 里，我坚持认为只有当需要跨组件共享状态时才使用 Vuex 才是正确的做法，否则就是徒增代码量而已</li>\n</ul>","related":[{"slug":"use-css-loading","title":"在Vue中使用Stylus编写loading特效","date":"2020-04-01","tags":["Vue","Stylus"],"category":"Front-end","excerpt":"在Vue中使用Stylus编写loading特效","author":"Dongsheng Zhao","readingTime":1},{"slug":"front-end-framework-compare","title":"Svelte, Vue, React生态小结","date":"2022-08-17","tags":["Vue","React","Svelte"],"category":"Front-end","excerpt":"Svelte, Vue, React生态小结","author":"Dongsheng Zhao","readingTime":1},{"slug":"svelte-use-experience","title":"Svelte使用分析","date":"2022-07-01","cover":"/logos/svelte.svg","tags":["Svelte","Vue","React"],"category":"Front-end","excerpt":"Svelte使用分析","author":"Dongsheng Zhao","readingTime":1}]}